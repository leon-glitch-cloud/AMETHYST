# Supabase-Projekt-URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Service-Role-Key (Project Settings → API) – NIE clientseitig verwenden!
SUPABASE_SERVICE_ROLE_KEY=

# Gemeinsames Passwort für den Zugriffsschutz
APP_PASSWORD=

# Zufälliges, langes Secret zum Signieren der Session-Cookies
# z. B. generieren mit: openssl rand -hex 32
APP_SESSION_SECRET=

# Anthropic API-Key (console.anthropic.com) – für die KI-Perlen-Erkennung
ANTHROPIC_API_KEY=
